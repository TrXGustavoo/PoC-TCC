<mxfile host="app.diagrams.net" modified="2026-10-05T19:00:00.000Z" agent="Antigravity" version="21.0.0" type="device"><diagram id="diag_fisico" name="Ambiente Físico - Edge IoT (TCC 2)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="850" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" value="1. AMEAÇAS EXTERNAS" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#fef2f2;strokeColor=#f87171;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="160" height="650" as="geometry"/></mxCell>
<mxCell id="n_attacker" value="&lt;b&gt;Atacante / Botnet&lt;/b&gt;&lt;br/&gt;• Mirai, Mozi, Gafgyt&lt;br/&gt;• Força Bruta SSH&lt;br/&gt;• Exploração de vulnerabilidades&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Porta Pública 22&lt;/b&gt;&lt;br/&gt;(Roteador / NAT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;" vertex="1" parent="c1"><mxGeometry x="15" y="180" width="130" height="170" as="geometry"/></mxCell>
<mxCell id="c2" value="2. HARDWARE DE BORDA (Raspberry Pi 4 - 100.127.31.12)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#fff1f2;strokeColor=#e11d48;" vertex="1" parent="1"><mxGeometry x="220" y="50" width="270" height="650" as="geometry"/></mxCell>
<mxCell id="n_admin_ssh" value="&lt;b&gt;🛡️ SSH Administrativo Real&lt;/b&gt;&lt;br/&gt;Porta 50022 (Ofuscada / UFW)&lt;br/&gt;Acesso exclusivo via VPN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="c2"><mxGeometry x="15" y="50" width="240" height="60" as="geometry"/></mxCell>
<mxCell id="n_cowrie" value="&lt;b&gt;🍯 Cowrie Honeypot&lt;/b&gt; (:2222)&lt;br/&gt;• Emulação SSH/Telnet interativa&lt;br/&gt;• Captura de credenciais e força bruta&lt;br/&gt;• Interceptação de comandos shell&lt;br/&gt;• Download de artefatos de malware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#f43f5e;" vertex="1" parent="c2"><mxGeometry x="15" y="140" width="240" height="130" as="geometry"/></mxCell>
<mxCell id="n_cowrie_log" value="📄 &lt;b&gt;cowrie.json&lt;/b&gt; (Telemetria Bruta)&lt;br/&gt;&lt;code&gt;/var/log/cowrie/cowrie.json&lt;/code&gt;&lt;br/&gt;Persistido no volume Docker" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f1f5f9;strokeColor=#94a3b8;" vertex="1" parent="c2"><mxGeometry x="15" y="300" width="240" height="60" as="geometry"/></mxCell>
<mxCell id="n_promtail_edge" value="&lt;b&gt;Promtail Edge&lt;/b&gt; (Docker no Pi)&lt;br/&gt;• Shipper nativo na borda&lt;br/&gt;• Leitura contínua do cowrie.json&lt;br/&gt;• Label: {host="edge-raspberry"}&lt;br/&gt;• Envio contínuo via VPN Tailscale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;" vertex="1" parent="c2"><mxGeometry x="15" y="390" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="c3" value="3. TRANSPORTE (VPN)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#f0fdfa;strokeColor=#0d9488;" vertex="1" parent="1"><mxGeometry x="520" y="50" width="140" height="650" as="geometry"/></mxCell>
<mxCell id="n_vpn" value="🔒 &lt;b&gt;Tailscale VPN&lt;/b&gt;&lt;br/&gt;Mesh WireGuard&lt;br/&gt;Ponto-a-Ponto&lt;br/&gt;&lt;br/&gt;Rede 100.x.x.x&lt;br/&gt;&lt;br/&gt;Túnel criptografado&lt;br/&gt;sem expor portas&lt;br/&gt;na Internet pública" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#14b8a6;" vertex="1" parent="c3"><mxGeometry x="15" y="180" width="110" height="190" as="geometry"/></mxCell>
<mxCell id="c4" value="4. HOST CENTRAL: SOC &amp; IA GENERATIVA (100.104.128.9)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#eff6ff;strokeColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="690" y="50" width="480" height="650" as="geometry"/></mxCell>
<mxCell id="n_loki_f" value="&lt;b&gt;Grafana Loki&lt;/b&gt; (:3100)&lt;br/&gt;• Ingestão Segura via Tailscale&lt;br/&gt;• Indexação temporal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;" vertex="1" parent="c4"><mxGeometry x="15" y="50" width="210" height="80" as="geometry"/></mxCell>
<mxCell id="n_grafana_f" value="&lt;b&gt;Grafana&lt;/b&gt; (:3000)&lt;br/&gt;• Dashboards de Ataques&lt;br/&gt;• Alertas LogQL imediatos&lt;br/&gt;• Webhook para a API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;" vertex="1" parent="c4"><mxGeometry x="15" y="150" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="n_chroma" value="&lt;b&gt;ChromaDB&lt;/b&gt; (:8000)&lt;br/&gt;&lt;i&gt;Memória RAG&lt;/i&gt;&lt;br/&gt;• Coleção honeypot_attacks&lt;br/&gt;• nomic-embed-text&lt;br/&gt;• Persistido no Git" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#9333ea;" vertex="1" parent="c4"><mxGeometry x="250" y="50" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="n_ollama_f" value="&lt;b&gt;Ollama LLMOps&lt;/b&gt; (:11434)&lt;br/&gt;• Llama 3.2 (Análise Forense)&lt;br/&gt;• nomic-embed-text (768d)&lt;br/&gt;• MITRE ATT&amp;CK Mapping&lt;br/&gt;• Zero nuvem (Offline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4f46e5;" vertex="1" parent="c4"><mxGeometry x="250" y="160" width="210" height="100" as="geometry"/></mxCell>
<mxCell id="n_api_f" value="&lt;b&gt;FastAPI Orchestrator (alerts-api :5000)&lt;/b&gt;&lt;br/&gt;• Recebe Webhook • Enriquece GeoIP/ASN/ISP&lt;br/&gt;• Orquestra RAG &amp; ChromaDB • Gera Regras Defesa Ativa&lt;br/&gt;• Endpoints: /webhook | /alerts | /iocs | /chat | /export/firewall" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;" vertex="1" parent="c4"><mxGeometry x="15" y="280" width="445" height="100" as="geometry"/></mxCell>
<mxCell id="n_soar" value="🛡️ &lt;b&gt;RESPOSTA ATIVA &amp; DEFESA PERIMETRAL (SOAR)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Firewall:&lt;/b&gt; Scripts UFW (Pi) e iptables (Gateways) gerados automaticamente&lt;br/&gt;• &lt;b&gt;Malware Hashes:&lt;/b&gt; Assinaturas SHA-256 extraídas de malwares para SIEM/EDR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;" vertex="1" parent="c4"><mxGeometry x="15" y="410" width="445" height="80" as="geometry"/></mxCell>
<mxCell id="c5" value="5. INTERFACES DO SOC" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1200" y="50" width="250" height="650" as="geometry"/></mxCell>
