<mxCell id="n_st_f" value="&lt;b&gt;Streamlit SOC (:8501)&lt;/b&gt;&lt;br/&gt;1. Feed Tático GeoIP&lt;br/&gt;2. IoCs &amp; Defesa Ativa (UFW)&lt;br/&gt;3. Malware Intel (SHA-256 + VirusTotal)&lt;br/&gt;4. RAG Chatbot Investigativo&lt;br/&gt;5. Observabilidade Grafana (Iframe)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;" vertex="1" parent="c5"><mxGeometry x="15" y="150" width="220" height="180" as="geometry"/></mxCell>
